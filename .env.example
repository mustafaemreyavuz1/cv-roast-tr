# LLM Saglayici Secimi: gemini | openai | anthropic (varsayilan: gemini)
LLM_PROVIDER=gemini

# Opsiyonel: Model adi (bos birakilirsa saglayicinin varsayilan modeli kullanilir)
# Gemini varsayilan: gemini-3.5-flash (yedek zinciri: gemini-3.1-flash-lite -> gemini-flash-lite-latest)
# OpenAI varsayilan: gpt-4o-mini
# Anthropic varsayilan: claude-3-5-sonnet-latest
LLM_MODEL=

# Secili saglayicinin API anahtari (gercek anahtarinizi .env.local dosyasina yazin)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opsiyonel: IP basina rate limit ayarlari
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
